rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /orders/{orderId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /customers/{customerId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /order_assignments/{assignmentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /branches/{branchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /statusLogs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /order_status_logs/{logId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payment_transaction/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /payment_breakdown/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /commissions/{document} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
